# Replace every placeholder before installation. Origin has no trailing slash or /docs.
DOCS_ORIGIN=https://contracts.example.org
DOCS_PORT=3107
DOCS_DATA=/var/lib/contract-docs
DOCS_RUNTIME=/run/contract-docs
NODE_ENV=production

# Analysis executor. One per process, fixed at startup; switching on a live
# instance is not supported. See references/local-deployment.md, section 6.
DOCS_MODEL_PROVIDER=codex

# --- codex: shared ChatGPT login of the application (default) ---
DOCS_CODEX_ADMIN=change-me
DOCS_CODEX=/usr/bin/codex

# --- local: internal vLLM server, no subscription and no API key ---
# Uncomment together with DOCS_MODEL_PROVIDER=local and comment out the codex
# block above. Only internal addresses are accepted for the endpoint.
#DOCS_LOCAL_ENDPOINT=http://10.0.0.15:8000/v1
#DOCS_LOCAL_MODEL=Qwen/Qwen3.5-27B-Instruct
#DOCS_LOCAL_MODEL_REVISION=change-me-weights-sha
#DOCS_LOCAL_TOKENIZER_REVISION=change-me-tokenizer-sha
#DOCS_LOCAL_CHAT_TEMPLATE_FILE=/etc/contract-docs/chat-template.jinja
#DOCS_LOCAL_CHAT_TEMPLATE_SHA256=change-me-sha256-of-that-file
#DOCS_LOCAL_CONTEXT_WINDOW=65536
#DOCS_LOCAL_API_KEY=
#DOCS_LOCAL_TIMEOUT_MS=720000
#DOCS_LOCAL_TEMPORARY_POLICY=memory-only-attested

# --- cloud vendor: openai | deepseek | kimi | anthropic ---
# Document text leaves the installation perimeter in this mode.
#DOCS_CLOUD_API_KEY=change-me
#DOCS_CLOUD_MODEL=change-me
#DOCS_CLOUD_CONTEXT_WINDOW=128000
#DOCS_CLOUD_BASE_URL=
#DOCS_CLOUD_API_VERSION=

# --- signed legal packages (optional) ---
# Both are required together, with at least two named reviewers.
#DOCS_LEGAL_TRUSTED_KEYS_FILE=/etc/contract-docs/legal-keys.json
#DOCS_LEGAL_REVIEWERS=lawyer-one,lawyer-two
#DOCS_LEGAL_PACKAGES_DIR=/var/lib/contract-docs/legal-packages
