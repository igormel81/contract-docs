[Unit]
Description=Contract documents workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=contract-docs
Group=contract-docs
WorkingDirectory=/opt/contract-docs/current
ExecStart=/usr/bin/node /opt/contract-docs/current/server/main.mjs
EnvironmentFile=/etc/contract-docs/contract-docs.env
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
StateDirectory=contract-docs
StateDirectoryMode=0700
RuntimeDirectory=contract-docs
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/contract-docs /run/contract-docs
LimitCORE=0
MemoryMax=1G
MemorySwapMax=0
CPUQuota=200%
TasksMax=128
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
