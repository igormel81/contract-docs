[Unit]
Description=Contract documents workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=contract-docs
Group=contract-docs
WorkingDirectory=/opt/contract-docs/current
ExecStart=/usr/bin/node /opt/contract-docs/current/server/main.mjs
Environment=NODE_ENV=production
Environment=DOCS_ORIGIN=https://igoruan.ru
Environment=DOCS_PORT=3107
Environment=DOCS_DATA=/var/lib/contract-docs
Environment=DOCS_CODEX=/usr/bin/codex
Environment=DOCS_CODEX_ADMIN=igor
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
StateDirectory=contract-docs
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/contract-docs
InaccessiblePaths=-/etc/caddy-naive -/opt/cv-gate -/opt/vector -/opt/self -/var/www
MemoryMax=768M
CPUQuota=120%
TasksMax=128
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
